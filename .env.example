# Copy this file to .env and fill in real values. Never commit .env.
# Vars prefixed EXPO_PUBLIC_ are bundled into the client app - do not put secret keys here.

# --- Firebase (Project settings > General > Your apps > Web app) ---
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Google Maps Platform (Maps SDK for Android/iOS, Places API, Geocoding API) ---
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Stripe (Dashboard > Developers > API keys) ---
# Publishable key is safe for the client. Secret key goes ONLY in Cloud Functions config, never here.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_STRIPE_MERCHANT_ID=merchant.com.spotbnb.app

# --- EAS (Expo Application Services, for Play Store builds) ---
EXPO_PUBLIC_EAS_PROJECT_ID=
