rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      // Stripe account fields are only ever written by Cloud Functions (admin SDK bypasses rules).
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['stripeConnectAccountId', 'stripeConnectOnboarded']);
      allow delete: if false;
    }

    match /spots/{spotId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Bookings and payment state are only ever written by Cloud Functions,
    // so pricing and availability can't be tampered with client-side.
    match /bookings/{bookingId} {
      allow read: if isSignedIn()
        && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
      allow write: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
