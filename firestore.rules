rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBookingParticipant(bookingId) {
      let booking = get(/databases/$(database)/documents/bookings/$(bookingId)).data;
      return isSignedIn() && (booking.buyerId == request.auth.uid || booking.sellerId == request.auth.uid);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      // Signup may initialize onboarding to false, but only the backend may
      // attach a Stripe account or mark onboarding complete.
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(['stripeConnectAccountId'])
        && request.resource.data.get('stripeConnectOnboarded', false) == false;
      // Stripe account fields are only ever written by Cloud Functions (admin SDK bypasses rules).
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['stripeConnectAccountId', 'stripeConnectOnboarded']);
      allow delete: if false;
    }

    match /spots/{spotId} {
      function canPublish() {
        return request.resource.data.isActive == false
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.stripeConnectOnboarded == true;
      }
      allow read: if resource.data.isActive == true || isOwner(resource.data.ownerId);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.isActive is bool && canPublish();
      allow update: if isOwner(resource.data.ownerId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.isActive is bool && canPublish();
      allow delete: if isOwner(resource.data.ownerId);
    }

    // Bookings and payment state are only ever written by Cloud Functions,
    // so pricing and availability can't be tampered with client-side.
    match /bookings/{bookingId} {
      allow read: if isSignedIn()
        && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
      allow write: if false;
      match /messages/{messageId} {
        allow read: if isBookingParticipant(bookingId);
        // The callable checks confirmed payment, membership, blocks and rate limits.
        allow write: if false;
      }
    }

    match /conversations/{bookingId} {
      allow get: if isBookingParticipant(bookingId);
      allow list: if isSignedIn() &&
        (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
      allow write: if false;
    }

    match /messageReports/{reportId} {
      allow read, write: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
