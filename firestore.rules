rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null
        && !exists(/databases/$(database)/documents/accountDeletions/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBookingParticipant(bookingId) {
      let booking = get(/databases/$(database)/documents/bookings/$(bookingId)).data;
      return isSignedIn() && (booking.buyerId == request.auth.uid || booking.sellerId == request.auth.uid);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      // Signup may initialize onboarding to false, but only the backend may
      // attach a Stripe account or mark onboarding complete.
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(['stripeConnectAccountId'])
        && request.resource.data.get('stripeConnectOnboarded', false) == false;
      // Stripe account fields are only ever written by Cloud Functions (admin SDK bypasses rules).
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['stripeConnectAccountId', 'stripeConnectOnboarded']);
      allow delete: if false;
    }

    match /spots/{spotId} {
      allow read: if resource.data.isActive == true || isOwner(resource.data.ownerId);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.isActive is bool
        && request.resource.data.get('averageRating', 0) == 0
        && request.resource.data.get('reviewCount', 0) == 0;
      allow update: if isOwner(resource.data.ownerId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.isActive is bool
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['averageRating', 'reviewCount']);
      allow delete: if isOwner(resource.data.ownerId);
    }

    // Bookings and payment state are only ever written by Cloud Functions,
    // so pricing and availability can't be tampered with client-side.
    match /bookings/{bookingId} {
      allow read: if isSignedIn()
        && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
      allow write: if false;
      match /messages/{messageId} {
        allow read: if isBookingParticipant(bookingId);
        // The callable checks confirmed payment, membership, blocks and rate limits.
        allow write: if false;
      }
    }

    match /conversations/{bookingId} {
      allow get: if isBookingParticipant(bookingId);
      allow list: if isSignedIn() &&
        (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
      allow write: if false;
    }

    match /messageReports/{reportId} {
      allow read, write: if false;
    }

    match /sellerTransfers/{bookingId} {
      allow get: if isOwner(get(/databases/$(database)/documents/bookings/$(bookingId)).data.sellerId);
      allow list: if isOwner(resource.data.sellerId);
      allow write: if false;
    }

    match /documentChecks/{userId}/roles/{role} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Only non-sensitive status/expiry fields are published here by the backend.
    match /documentBadges/{userId} {
      allow get: if true;
      allow list, write: if false;
    }

    match /reviews/{reviewId} {
      function validReview() {
        let review = request.resource.data;
        let booking = get(/databases/$(database)/documents/bookings/$(review.bookingId)).data;
        return review.keys().hasOnly(['bookingId', 'spotId', 'authorId', 'targetId', 'rating', 'comment', 'createdAt'])
          && booking.buyerId == request.auth.uid
          && booking.status == 'completed'
          && booking.get('buyerAccountDeleted', false) == false
          && booking.get('sellerAccountDeleted', false) == false
          && !exists(/databases/$(database)/documents/accountDeletions/$(booking.sellerId))
          && review.spotId == booking.spotId
          && review.targetId == booking.sellerId
          && review.rating is int && review.rating >= 1 && review.rating <= 5
          && review.comment is string && review.comment.size() <= 2000
          && review.createdAt == request.time;
      }
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid && validReview();
      allow update, delete: if false;
    }
  }
}
